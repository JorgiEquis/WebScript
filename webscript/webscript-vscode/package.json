{
  "name": "webscript-language",
  "displayName": "WebScript Language Support",
  "description": "Resaltado de sintaxis, snippets y ayuda contextual (hover) para archivos .ws de WebScript",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:webscript"],
  "contributes": {
    "languages": [
      {
        "id": "webscript",
        "aliases": ["WebScript", "webscript"],
        "extensions": [".ws"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "webscript",
        "scopeName": "source.webscript",
        "path": "./syntaxes/webscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "webscript",
        "path": "./snippets/webscript.json"
      }
    ]
  }
}

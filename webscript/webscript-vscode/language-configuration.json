{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((reactive|var|style|visual|for|if|else( if)?|server( var| function)?|post function)\\b.*=?\\s*|<[A-Za-z][^/]*[^/]>)\\s*$",
    "decreaseIndentPattern": "^\\s*(</[A-Za-z].*>)\\s*$"
  }
}

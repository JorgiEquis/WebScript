{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WebScript",
  "scopeName": "source.webscript",
  "fileTypes": ["ws"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#watch-decl" },
    { "include": "#declarations" },
    { "include": "#route-render" },
    { "include": "#for-header" },
    { "include": "#control-flow" },
    { "include": "#import-from" },
    { "include": "#bindings" },
    { "include": "#tags" },
    { "include": "#interpolation" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.webscript",
          "match": "^\\s*//.*$"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "comment": "reactive/var/const [tipo] NOMBRE (locales o globales) -- el tipo (string/number/boolean) es opcional",
          "match": "^\\s*(reactive|var|const)\\s+(?:(string|number|boolean)\\s+)?([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.webscript" },
            "2": { "name": "support.type.webscript" },
            "3": { "name": "variable.other.webscript" }
          }
        },
        {
          "comment": "function NOMBRE(...) -- helper de CLIENTE, cuerpo en varias líneas. Siempre puede usar await dentro sin declarar nada especial -- el compilador detecta solo si de verdad hace falta compilarla async (ver README, \"async/await implícito\")",
          "match": "^\\s*(function)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.webscript" },
            "2": { "name": "entity.name.function.webscript" }
          }
        },
        {
          "comment": "server var / server const / server reactive / server wson / server function NOMBRE. Toda server function puede usar await dentro, sin declarar nada especial",
          "match": "^\\s*(server)\\s+(var|const|reactive|wson|function)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.modifier.webscript" },
            "2": { "name": "storage.type.webscript" },
            "3": { "name": "entity.name.function.webscript" }
          }
        },
        {
          "comment": "get/post/put/delete/ws function NOMBRE(...) -- las cuatro funciones HTTP y ws function",
          "match": "^\\s*(get|post|put|delete|ws)\\s+(function)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.modifier.webscript" },
            "2": { "name": "storage.type.webscript" },
            "3": { "name": "entity.name.function.webscript" }
          }
        },
        {
          "comment": "style NOMBRE = / visual NOMBRE = / wson NOMBRE =",
          "match": "^\\s*(style|visual|wson)\\s+([A-Za-z_$][\\w$]*)\\s*(=)",
          "captures": {
            "1": { "name": "storage.type.webscript" },
            "2": { "name": "entity.name.function.webscript" },
            "3": { "name": "keyword.operator.assignment.webscript" }
          }
        }
      ]
    },

    "watch-decl": {
      "patterns": [
        {
          "comment": "watch(NOMBRE) -- observa una server reactive, corre solo en cambios posteriores",
          "match": "^\\s*(watch)\\s*(\\()\\s*([A-Za-z_$][\\w$]*)\\s*(\\))",
          "captures": {
            "1": { "name": "keyword.control.webscript" },
            "2": { "name": "punctuation.webscript" },
            "3": { "name": "variable.other.webscript" },
            "4": { "name": "punctuation.webscript" }
          }
        }
      ]
    },

    "route-render": {
      "patterns": [
        {
          "name": "keyword.control.webscript",
          "match": "\\b(route|render)\\b(?=\\s*\\()"
        }
      ]
    },

    "for-header": {
      "patterns": [
        {
          "comment": "for (item in lista [by clave]) -- \"by\" es opcional, activa el diffing por clave",
          "match": "^\\s*(for)\\s*(\\()\\s*([A-Za-z_$][\\w$]*)\\s+(in)\\s+([^)]*?)(?:\\s+(by)\\s+([^)]*?))?\\s*(\\))",
          "captures": {
            "1": { "name": "keyword.control.loop.webscript" },
            "2": { "name": "punctuation.webscript" },
            "3": { "name": "variable.other.webscript" },
            "4": { "name": "keyword.operator.wordlike.webscript" },
            "6": { "name": "keyword.operator.wordlike.webscript" },
            "8": { "name": "punctuation.webscript" }
          }
        }
      ]
    },

    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.webscript",
          "match": "^\\s*\\b(if|else\\s+if|else)\\b"
        }
      ]
    },

    "import-from": {
      "patterns": [
        {
          "match": "^\\s*(import)\\s*\\{([^}]*)\\}\\s*(from)\\b",
          "captures": {
            "1": { "name": "keyword.control.webscript" },
            "2": { "name": "variable.other.webscript" },
            "3": { "name": "keyword.control.webscript" }
          }
        }
      ]
    },

    "bindings": {
      "patterns": [
        {
          "comment": "-> propiedad: valor (style) | -> from/to/via/content: valor (wson) -- ya NO se usa para eventos/atributos de visual, esos van en línea en la etiqueta (onclick={...}, class={...})",
          "match": "(->)\\s*([A-Za-z_][\\w-]*)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.operator.arrow.webscript" },
            "2": { "name": "support.type.property-name.webscript" },
            "3": { "name": "punctuation.separator.key-value.webscript" }
          }
        },
        {
          "name": "keyword.operator.arrow.webscript",
          "match": "->"
        }
      ]
    },

    "tags": {
      "patterns": [
        {
          "name": "meta.tag.webscript",
          "begin": "(</?)([A-Za-z_][\\w-]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.webscript" },
            "2": { "name": "entity.name.tag.webscript" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.webscript" }
          },
          "patterns": [
            { "include": "#tag-attributes" },
            { "include": "#interpolation" },
            { "include": "#strings" }
          ]
        }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.webscript",
          "match": "\\b[A-Za-z_:][\\w:-]*(?=\\s*=)"
        }
      ]
    },

    "interpolation": {
      "name": "meta.embedded.expression.webscript",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.webscript" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.webscript" } },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "name": "keyword.other.webscript",
          "match": "\\b(props|state|server|http|whisper|respond|params|query|WSON|await|true|false|null|undefined|this)\\b"
        },
        {
          "name": "keyword.control.webscript",
          "match": "\\b(if|else|for|in|by|return|function)\\b"
        },
        {
          "name": "entity.name.function.webscript",
          "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\()"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.webscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.webscript", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.webscript",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.webscript", "match": "\\\\." }]
        },
        {
          "name": "string.template.webscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "name": "constant.character.escape.webscript", "match": "\\\\." },
            {
              "name": "meta.template.expression.webscript",
              "begin": "\\$\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.webscript" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.webscript" } },
              "patterns": [{ "include": "#strings" }, { "include": "#numbers" }]
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.webscript", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WebScript",
  "scopeName": "source.webscript",
  "fileTypes": ["ws"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#route-render" },
    { "include": "#control-flow" },
    { "include": "#import-from" },
    { "include": "#bindings" },
    { "include": "#tags" },
    { "include": "#interpolation" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.webscript",
          "match": "^\\s*//.*$"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "comment": "reactive NOMBRE / var NOMBRE (locales o globales)",
          "match": "^\\s*(reactive|var)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.webscript" },
            "2": { "name": "variable.other.webscript" }
          }
        },
        {
          "comment": "server var NOMBRE / server function NOMBRE(...)",
          "match": "^\\s*(server)\\s+(var|function)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.modifier.webscript" },
            "2": { "name": "storage.type.webscript" },
            "3": { "name": "entity.name.function.webscript" }
          }
        },
        {
          "comment": "post function NOMBRE(...)",
          "match": "^\\s*(post)\\s+(function)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.modifier.webscript" },
            "2": { "name": "storage.type.webscript" },
            "3": { "name": "entity.name.function.webscript" }
          }
        },
        {
          "comment": "style NOMBRE = / visual NOMBRE =",
          "match": "^\\s*(style|visual)\\s+([A-Za-z_$][\\w$]*)\\s*(=)",
          "captures": {
            "1": { "name": "storage.type.webscript" },
            "2": { "name": "entity.name.function.webscript" },
            "3": { "name": "keyword.operator.assignment.webscript" }
          }
        }
      ]
    },

    "route-render": {
      "patterns": [
        {
          "name": "keyword.control.webscript",
          "match": "\\b(route|render)\\b(?=\\s*\\()"
        }
      ]
    },

    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.webscript",
          "match": "^\\s*\\b(if|else\\s+if|else)\\b"
        },
        {
          "name": "keyword.control.loop.webscript",
          "match": "^\\s*\\b(for)\\b"
        },
        {
          "name": "keyword.operator.wordlike.webscript",
          "match": "(?<=\\bfor\\s*\\([^)]*\\s)(in)(?=\\s)"
        }
      ]
    },

    "import-from": {
      "patterns": [
        {
          "match": "^\\s*(import)\\s*\\{([^}]*)\\}\\s*(from)\\b",
          "captures": {
            "1": { "name": "keyword.control.webscript" },
            "2": { "name": "variable.other.webscript" },
            "3": { "name": "keyword.control.webscript" }
          }
        }
      ]
    },

    "bindings": {
      "patterns": [
        {
          "comment": "-> style: nombre  |  -> onclick:  |  -> atributo: valor",
          "match": "(->)\\s*([A-Za-z_][\\w-]*)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.operator.arrow.webscript" },
            "2": { "name": "support.type.property-name.webscript" },
            "3": { "name": "punctuation.separator.key-value.webscript" }
          }
        },
        {
          "name": "keyword.operator.arrow.webscript",
          "match": "->"
        }
      ]
    },

    "tags": {
      "patterns": [
        {
          "name": "meta.tag.webscript",
          "begin": "(</?)([A-Za-z_][\\w-]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.webscript" },
            "2": { "name": "entity.name.tag.webscript" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.webscript" }
          },
          "patterns": [
            { "include": "#tag-attributes" },
            { "include": "#interpolation" },
            { "include": "#strings" }
          ]
        }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.webscript",
          "match": "\\b[A-Za-z_:][\\w:-]*(?=\\s*=)"
        }
      ]
    },

    "interpolation": {
      "name": "meta.embedded.expression.webscript",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.webscript" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.webscript" } },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "name": "keyword.other.webscript",
          "match": "\\b(props|state|server|await|true|false|null|undefined|this)\\b"
        },
        {
          "name": "keyword.control.webscript",
          "match": "\\b(if|else|for|in|return|function)\\b"
        },
        {
          "name": "entity.name.function.webscript",
          "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\()"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.webscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.webscript", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.webscript",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.webscript", "match": "\\\\." }]
        },
        {
          "name": "string.template.webscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "name": "constant.character.escape.webscript", "match": "\\\\." },
            {
              "name": "meta.template.expression.webscript",
              "begin": "\\$\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.webscript" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.webscript" } },
              "patterns": [{ "include": "#strings" }, { "include": "#numbers" }]
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.webscript", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    }
  }
}

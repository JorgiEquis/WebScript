import { Persona } from "./persona.wson"

// Estado por sesión — vive aquí por ser un .wsb, sin prefijo "server"
var visitasSesion = 0

const WSON wsonCrearPersona =
	-> to: "/personas"
	-> via: "POST"
	-> secret: "clave-compartida-entre-sistemas"

reactive any peticionPersona = WSON.listen(wsonCrearPersona)

watch(peticionPersona)
	visitasSesion++

	var contenido = WSON.showContent(peticionPersona, "clave-compartida-entre-sistemas")
	var nueva = new Persona(
		contenido.nombre,
		contenido.edad,
		contenido.altura,
		contenido.mayorEdad,
		contenido.direccion,
		contenido.listaPropiedades
	)

	// httpSend() no es obligatorio aquí — sin él, se responde 200 por
	// defecto. WSON.httpSend(peticionPersona, 201) responde la propia
	// petición entrante con el código indicado (por eso "http" en el
	// nombre) — distinto de WSON.send(), que manda una llamada saliente
	// nueva hacia cualquier otro destino.
	WSON.httpSend(peticionPersona, 201)

// GET /personas/:id — mismo mecanismo que POST, vía WSON.listen()/watch()
// (el renderizado del visual en el cliente es cosa de Visual.route(), en
// el .wsf — esto de aquí es solo la API que le da los datos).
const WSON wsonObtenerPersona =
	-> to: "/personas/:id"
	-> via: "GET"

reactive any peticionObtenerPersona = WSON.listen(wsonObtenerPersona)

watch(peticionObtenerPersona)
	var id = WSON.httpParams(peticionObtenerPersona).id
	peticionObtenerPersona.content = { id: id, nombre: "Ana", edad: 30 }
	WSON.httpSend(peticionObtenerPersona)
